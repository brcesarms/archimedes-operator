#!/usr/bin/env bash
# ============================================================
# 👷‍♂️ Archimedes Operator CLI
# ============================================================
# Braço Mecânico de Automação Remota e Bancada
# ============================================================
set -euo pipefail

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VENV_PY="$REPO_DIR/.venv/bin/python"

# Se o venv não existir, usa o python3 do sistema
if [ ! -f "$VENV_PY" ]; then
    VENV_PY="$(command -v python3)"
fi

export PYTHONPATH="$REPO_DIR/scripts/python:${PYTHONPATH:-}"

# Se nenhum argumento for passado, abre o menu interativo
if [ $# -eq 0 ]; then
    exec "$VENV_PY" "$REPO_DIR/scripts/python/menu.py"
else
    exec "$VENV_PY" "$REPO_DIR/scripts/python/orquestrador.py" "$@"
fi
